// TASK 1.
int x{};

int enter_x(int& x) {
    std::cin >> x;
    return x;
}

int found_x_in_array(int* arr, int size, int x) {
    for (int i{}; i < size; ++i) {
        if (arr[i] == x) {
            return i;
        }
    }
    return -1;
}

// TASK 2. 
void is_sorted_non_decreasing(int* arr, int size) {
    for (int i = 1; i < size; ++i) {
        if (arr[i - 1] > arr[i]) {
            return false;
        }
    }
    return true;
}

// TASK 3. 
int count_numbers_larger_than_neighbors(int* arr, int size) {
    int quantity = 0;

    for (int i = 1; i < size - 1; ++i) {
        if (arr[i - 1] < arr[i] && arr[i + 1] < arr[i]) {
            quantity++;
        }
    }
    return quantity;
}

// TASK 4. 
void print_larger_than_average(int* arr, int size) {
    if (size <= 0) {
        std::cout << "Array is empty\n";
        return;
    }

    double sum = 0;
    for (int i{}; i < size; ++i) {
        sum += arr[i];
    }

    double average = sum / size;
    std::cout << "Average: " << average << '\n';
    std::cout << "Elements larger than average: ";

    bool found = false;
    for (int i{}; i < size; ++i) {
        if (arr[i] > average) {
            std::cout << arr[i] << ' ';
            found = true;
        }
    }

    if (found == false) {
        std::cout << "none";
    }
    std::cout << '\n';
}

// TASK 5.
void replace_negative_with_zero(int* arr, int size) {
    for (int i{}; i < size; ++i) {
        if (arr[i] < 0) {
            arr[i] = 0;
        }
    }
}

// TASK 6.
void reverse_array(int* arr, int size) {
    for (int i{}; i < size / 2; ++i) {
        int temp = arr[i];
        arr[i] = arr[size - 1 - i];
        arr[size - 1 - i] = temp;
    }
}
